{
  "name": "oferta-update",
  "version": "0.1.0",
  "private": true,
  "description": "genOferta AI — гибридный (алгоритм + ИИ) сборщик изменений в Публичную оферту",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "regress": "tsx scripts/regress.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.4",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
