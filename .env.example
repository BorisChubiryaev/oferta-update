# Ключ OpenRouter. В проде задаётся в Vercel → Settings → Environment Variables.
# Никогда не коммитить реальное значение и не выносить в NEXT_PUBLIC_*:
# переменные с этим префиксом попадают в бандл браузера.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Модель по умолчанию. Можно переопределить, не трогая код.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Необязательные заголовки атрибуции OpenRouter.
OPENROUTER_SITE_URL=https://oferta-update.vercel.app
OPENROUTER_SITE_NAME=genOferta AI
